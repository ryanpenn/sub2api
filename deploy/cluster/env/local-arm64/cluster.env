# 非敏感本地清单。G2 已回填 ARM64 平台 digest；G3 前仍不得部署。
ENVIRONMENT=local
DOCKER_CONTEXT=sub2api-local
STACK_NAME=sub2api-local
APP_NETWORK_NAME=sub2api-local-app
TARGET_ARCH=arm64
TZ=Asia/Shanghai

SUB2API_RELEASE=v0.1.165-ext.1
SUB2API_IMAGE=ghcr.io/ryanpenn/sub2api:v0.1.165-ext.1-arm64@sha256:1845076d3ff9dd23c15e807c754438c2dc142d7b1ce8cdee2e407d903c543708
