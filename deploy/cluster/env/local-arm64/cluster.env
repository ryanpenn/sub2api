REDIS_IMAGE=redis:8-alpine@sha256:ca5075df9552da2423c20c691a0208d60106f2ea71b47406d52c396bf0a6bd65

SUB2API_DOMAIN=sub2api.test
SUB2API_HEALTH_PATH=/health
NODE_ADDRESSES="192.168.252.2 192.168.252.3 192.168.252.4"
CADDY_LOCAL_CA_FILE=/etc/sub2api/caddy-local-ca.pem
