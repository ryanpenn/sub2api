CADDYFILE_CONFIG=sub2api-local-caddyfile-e7861ad7e3f4
MODEL_PRICING_CONFIG=sub2api-local-model-pricing-139de8a906ce
APP_CONFIG_SECRET=sub2api-local-app-config-v001
POSTGRES_PASSWORD_SECRET=sub2api-local-postgres-password-v001
REDIS_APP_PASSWORD_SECRET=sub2api-local-redis-app-password-v001
REDIS_CADDY_PASSWORD_SECRET=sub2api-local-redis-caddy-password-v001
CADDY_STORAGE_KEY_SECRET=sub2api-local-caddy-storage-key-v001
BOOTSTRAP_ADMIN_PASSWORD_SECRET=sub2api-local-bootstrap-admin-password-v001
BOOTSTRAP_ADMIN_EMAIL=admin@sub2api.test

SUB2API_MEMORY_RESERVATION=512MiB
SUB2API_MEMORY_LIMIT=2GiB
SUB2API_GOMEMLIMIT=1536MiB
