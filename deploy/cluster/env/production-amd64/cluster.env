# 非敏感生产模板。G2 已回填 AMD64 平台 digest；示例域名/IP 和未批准容量仍会阻断部署。
ENVIRONMENT=production
DOCKER_CONTEXT=sub2api-production
STACK_NAME=sub2api-production
APP_NETWORK_NAME=sub2api-production-app
TARGET_ARCH=amd64
SWARM_NODE_ARCH=x86_64
TZ=Asia/Shanghai

SUB2API_RELEASE=v0.1.165-ext.1
SUB2API_IMAGE_COMMIT=5779d0b4b0d7b4821f2283afd667598380343386
SUB2API_IMAGE=ghcr.io/ryanpenn/sub2api:v0.1.165-ext.1-amd64@sha256:0186e45b9e2cf7a9dad65dadb0e342b9275764ddd3da406c48d343cd1e43e08f
CADDY_IMAGE=ghcr.io/ryanpenn/sub2api-caddy:v2.11.4-redis-v1.8.1-amd64@sha256:b69f3df3fd10b6ec14db870047678e3be7cf511119169894100534404839cbed
POSTGRES_IMAGE=postgres:18-alpine@sha256:b6a16ed0eb96e2c362811f7eeb951eac8b459e7b40be4149ea5444aa7c65569b
REDIS_IMAGE=redis:8-alpine@sha256:465aff338d817971674ff1ec3c0d59182e2b687018e87bf94b6e1491d0bb79e2

SUB2API_DOMAIN=replace.example.invalid
SUB2API_HEALTH_PATH=/ready
NODE_ADDRESSES="REPLACE_WITH_PRIVATE_IPS"
ACTIVE_NODE_ADDRESSES="REPLACE_WITH_PRIVATE_IPS"
CADDY_LOCAL_CA_FILE=
CADDY_REDIS_ADDRESS=replace-with-redis-private-ip:6379

CADDYFILE_SOURCE=env/production-amd64/Caddyfile
MODEL_PRICING_SOURCE=../../backend/resources/model-pricing/model_prices_and_context_window.json
CADDYFILE_CONFIG=sub2api-production-caddyfile-38ad760f6e2c
MODEL_PRICING_CONFIG=sub2api-production-model-pricing-139de8a906ce
APP_CONFIG_SECRET=sub2api-production-app-config-v001
POSTGRES_PASSWORD_SECRET=sub2api-production-postgres-password-v001
REDIS_APP_PASSWORD_SECRET=sub2api-production-redis-app-password-v001
REDIS_CADDY_PASSWORD_SECRET=sub2api-production-redis-caddy-password-v001
CADDY_STORAGE_KEY_SECRET=sub2api-production-caddy-storage-key-v001
BOOTSTRAP_ADMIN_PASSWORD_SECRET=sub2api-production-bootstrap-admin-password-v001
BOOTSTRAP_ADMIN_EMAIL=replace-with-production-admin@example.invalid

# 下列 1MiB 值只为 G1 静态渲染；PRODUCTION_CAPACITY_APPROVED=false 会阻断发布。
SUB2API_MEMORY_RESERVATION=1MiB
SUB2API_MEMORY_LIMIT=1MiB
SUB2API_GOMEMLIMIT=1MiB
CADDY_MEMORY_RESERVATION=1GiB
CADDY_MEMORY_LIMIT=1GiB
POSTGRES_MEMORY_RESERVATION=2GiB
POSTGRES_MEMORY_LIMIT=2GiB
REDIS_MEMORY_RESERVATION=2GiB
REDIS_MEMORY_LIMIT=2GiB
PRODUCTION_CAPACITY_APPROVED=false
